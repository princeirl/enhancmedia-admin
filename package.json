{
  "name": "enhancmedia-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "next build",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "check:schema": "node scripts/check-schema-sync.mjs",
    "test": "node --test scripts/*.test.mjs",
    "deploy": "npm run typecheck && npm run build && wrangler deploy"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261108.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  }
}
